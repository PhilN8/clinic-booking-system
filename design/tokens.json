  "$pairsComment": "min is the WCAG 2.2 contrast requirement for that pair: 4.5 for body text (1.4.3), 3 for large text and UI component boundaries (1.4.11).",
  "$semanticsComment": "Available is deliberately NOT a colour. A free slot is the default state, so it is neutral; the only colour in the slot grid is the selection. Green is reserved for a completed action and red for cancellation or error, which keeps green and red from being the pair a colour-blind reader has to separate.",
  "pairs": [
    { "fg": "neutral.900", "bg": "neutral.0",   "use": "Primary body text on a page",                       "min": 4.5 },
    { "fg": "neutral.600", "bg": "neutral.0",   "use": "Secondary text, labels, helper copy",               "min": 4.5 },
    { "fg": "neutral.500", "bg": "neutral.0",   "use": "Muted text, timestamps, placeholders",               "min": 4.5 },
    { "fg": "neutral.900", "bg": "neutral.50",  "use": "Primary text on a subtle surface",                  "min": 4.5 },
    { "fg": "neutral.700", "bg": "neutral.100", "use": "Badge text on a neutral badge",                     "min": 4.5 },
    { "fg": "neutral.900", "bg": "neutral.0",   "use": "Available slot label, the default unremarkable state","min": 4.5 },
    { "fg": "brand.700",   "bg": "neutral.0",   "use": "Link text",                                         "min": 4.5 },
    { "fg": "brand.800",   "bg": "neutral.0",   "use": "Visited link text",                                 "min": 4.5 },
    { "fg": "brand.800",   "bg": "brand.50",    "use": "Booked appointment badge",                         "min": 4.5 },
    { "fg": "brand.700",   "bg": "brand.50",    "use": "Brand text on a brand tint",                        "min": 4.5 },
    { "fg": "neutral.0",   "bg": "brand.600",   "use": "Primary button label",                              "min": 4.5 },
    { "fg": "neutral.0",   "bg": "brand.700",   "use": "Primary button label, hover",                        "min": 4.5 },
    { "fg": "neutral.0",   "bg": "brand.900",   "use": "Footer band text",                                  "min": 4.5 },
    { "fg": "neutral.300", "bg": "neutral.0",   "use": "Divider and card border, decorative only",          "min": 1.0 },
    { "fg": "neutral.500", "bg": "neutral.0",   "use": "Input border",                                      "min": 3.0 },
    { "fg": "neutral.500", "bg": "neutral.0",   "use": "Available slot border",                             "min": 3.0 },
    { "fg": "brand.600",   "bg": "neutral.0",   "use": "Focus ring and selected slot border",               "min": 3.0 },
    { "fg": "brand.600",   "bg": "neutral.50",  "use": "Selected slot border on a subtle surface",          "min": 3.0 },
    { "fg": "success.800", "bg": "success.50",  "use": "Confirmation banner",                               "min": 4.5 },
    { "fg": "success.700", "bg": "neutral.0",   "use": "Success text",                                      "min": 4.5 },
    { "fg": "warning.800", "bg": "neutral.0",   "use": "Too soon to book warning text",                     "min": 4.5 },
    { "fg": "warning.800", "bg": "warning.50",  "use": "Warning badge text",                                "min": 4.5 },
    { "fg": "danger.700",  "bg": "neutral.0",   "use": "Error text",                                        "min": 4.5 },
    { "fg": "danger.800",  "bg": "danger.50",   "use": "Cancelled badge text",                              "min": 4.5 },
    { "fg": "danger.600",  "bg": "neutral.0",   "use": "Destructive action border",                         "min": 3.0 },
