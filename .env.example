# Copy to .env and adjust. The service reads these directly from the
# environment; there is no .env file loader, so export them or use the
# docker-compose service definitions.

# Required. Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic?sslmode=disable

# Optional. Port the HTTP server listens on. Defaults to 8080.
PORT=8080

# Optional. IANA timezone the clinic operates in. Defaults to Africa/Nairobi.
# The wall-clock time model assumes a single, DST-free zone.
CLINIC_TZ=Africa/Nairobi

# Optional. One of debug, info, warn, error. Defaults to info.
LOG_LEVEL=info

# Optional. Used by the integration tests. When unset those tests skip.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic_test?sslmode=disable
